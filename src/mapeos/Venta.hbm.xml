<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Venta" table="venta">
        <id name="idVenta" column="id_venta" type="long">
            <generator class="identity"/>
        </id>
        <property name="cantidad" column="cantidad" type="integer" not-null="true"/>

        <many-to-one name="plato" class="datos.Plato" column="id_plato" not-null="true"/>
        <many-to-one name="pedido" class="datos.Pedido" column="id_pedido" not-null="true"/>
    </class>
</hibernate-mapping>