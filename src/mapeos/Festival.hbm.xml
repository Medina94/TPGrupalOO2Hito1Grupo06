<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Festival" table="festival">
        <id name="idFestival" column="id_festival" type="long">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="string" not-null="true"/>
        <property name="fechaInicio" column="fecha_Inicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fecha_fin" type="java.time.LocalDate" not-null="true"/>

        <set name="unidadesDeVenta" table="unidad_venta" order-by="id_unidad_venta asc" inverse="true" lazy="true">
            <key column="id_festival"/>
            <one-to-many class="datos.UnidadVenta"/>
        </set>

        <set name="pedidos" table="pedido" order-by="id_unidad_venta asc" inverse="true" lazy="true">
            <key column="id_festival"/>
            <one-to-many class="datos.Pedido"/>
        </set>
    </class>
</hibernate-mapping>