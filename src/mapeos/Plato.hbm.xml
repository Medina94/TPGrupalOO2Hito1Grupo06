<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Plato" table="plato">
        <id name="idPlato" column="id_plato" type="long">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="precioVenta" column="precio_venta" type="double" not-null="true"/>
        <property name="costoProduccion" column="costo_produccion" type="double" not-null="true"/>

        <many-to-one name="unidadVenta" class="datos.UnidadVenta" column="id_unidad_venta" not-null="true"/>

        <set name="ventas" table="venta" inverse="true" lazy="true">
            <key column="id_plato"/>
            <one-to-many class="datos.Venta"/>
        </set>
    </class>
</hibernate-mapping>