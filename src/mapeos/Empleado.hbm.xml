<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Empleado" table="empleado">
        <id name="idEmpleado" column="idEmpleado" type="long">
            <generator class="identity"/>
        </id>
        <property name="edad" column="edad" type="integer"/>
        <property name="nombre" column="nombre" type="string"/>
        <property name="apellido" column="apellido" type="string"/>
        <property name="dni" column="dni" type="integer"/>
        <property name="fechaNacimiento" column="fechaNacimiento" type="org.hibernate.type.LocalDateType"/>
        <property name="fechaIngreso" column="fechaIngreso" type="org.hibernate.type.LocalDateType"/>
        <property name="sueldoBase" column="sueldoBase" type="double"/>

        <joined-subclass name="datos.Cocinero" table="cocinero">
            <key column="idEmpleado"/>
            <property name="especialidadCulinaria" column="especialidadCulinaria" type="string"/>
            <property name="plus" column="plus" type="double"/>
        </joined-subclass>

        <joined-subclass name="datos.Cajero" table="cajero">
            <key column="idEmpleado"/>
            <property name="turno" column="turno" type="string"/>
        </joined-subclass>
    </class>
</hibernate-mapping>