<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping>
    <class name="datos.Empleado" table="empleado">
        <id name="idEmpleado" column="id_empleado" type="long">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="apellido" column="apellido" type="string" not-null="true"/>
        <property name="dni" column="dni" type="integer" not-null="true"/>
        <property name="fechaNacimiento" column="fecha_nacimiento" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaIngreso" column="fecha_ingreso" type="java.time.LocalDate" not-null="true"/>
        <property name="sueldoBase" column="sueldo_base" type="double" not-null="true"/>
		<property name="antiguedad" column="antiguedad" type="integer" not-null="false"/>
        <many-to-one name="unidadVenta" class="datos.UnidadVenta" column="id_unidad_venta" not-null="false"/>

        <joined-subclass name="datos.Cocinero" table="cocinero">
            <key column="id_empleado"/>
            <property name="especialidadCulinaria" column="especialidad_culinaria" type="string" not-null="true"/>
            <property name="plus" column="plus" type="double" not-null="true"/>
        </joined-subclass>

        <joined-subclass name="datos.Cajero" table="cajero">
            <key column="id_empleado"/>
            <property name="turno" column="turno" type="string" not-null="true"/>
        </joined-subclass>
    </class>
</hibernate-mapping>